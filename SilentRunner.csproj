<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>SilentRunner</AssemblyName>
    <Authors>José Luis Bautista Martín</Authors>
    <Company>José Luis Bautista Martín</Company>
    <Copyright>Copyright © 2026 José Luis Bautista Martín</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- La clave de firma vive fuera del repositorio: nunca se publica con el código.
         Si no está disponible (p. ej. un clon de otra persona), el proyecto compila sin firmar. -->
    <AssemblyOriginatorKeyFile>..\Claves\capicua.snk</AssemblyOriginatorKeyFile>
    <SignAssembly Condition="Exists('$(AssemblyOriginatorKeyFile)')">true</SignAssembly>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ApplicationIcon>SilentRunner.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SilentRunner.ico" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
  </ItemGroup>

</Project>
